<Page x:Class="MaterialAssetsApp.Pages.AddDepartmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Подразделения"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Подразделения"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Список подразделений -->
        <GroupBox Grid.Row="1" Grid.Column="0"
                  Header="Список подразделений"
                  Margin="0,0,10,0">
            <DataGrid x:Name="dgDepartments"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgDepartments_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding DepartmentID}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding DepartmentName}" Width="150"/>
                    <DataGridTextColumn Header="Родительское"
                                        Binding="{Binding Department2.DepartmentName}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Редактирование -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Редактирование подразделения"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" Text="Родительское подразделение:" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="2"
                      x:Name="cbParentDepartment"
                      DisplayMemberPath="DepartmentName"
                      SelectedValuePath="DepartmentID"
                      Margin="0,0,0,15"/>

            <TextBlock Grid.Row="3" Text="Название подразделения:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="4" x:Name="txtDepartmentName" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="Сохранить"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button Content="Удалить"
                        Width="120"
                        Height="35"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>