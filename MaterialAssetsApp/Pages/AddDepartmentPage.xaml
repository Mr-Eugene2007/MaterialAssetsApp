<Page x:Class="MaterialAssetsApp.Pages.AddDepartmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавить подразделение">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Добавление подразделения"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Название подразделения (обязательно) -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Название подразделения:"
                       Margin="0,0,5,5"
                       VerticalAlignment="Center"/>
            <TextBox   Grid.Row="0" Grid.Column="1"
                       x:Name="txtDepartmentName"
                       Margin="0,0,0,5"/>

            <!-- Родительское подразделение (необязательно) -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Родительское подразделение:"
                       Margin="0,0,5,5"
                       VerticalAlignment="Center"/>
            <ComboBox  Grid.Row="1" Grid.Column="1"
                       x:Name="cbParentDepartment"
                       DisplayMemberPath="DepartmentName"
                       SelectedValuePath="DepartmentID"
                       Margin="0,0,0,5"
                       IsEditable="False"
                       IsReadOnly="True"
                       />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Сохранить"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>
            <Button Content="Очистить"
                    Width="120"
                    Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Page>
