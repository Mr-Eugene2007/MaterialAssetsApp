<Page x:Class="MaterialAssetsApp.Pages.EditMovementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование перемещения">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Редактирование перемещения"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Форма -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Дата -->
                    <RowDefinition Height="Auto"/>
                    <!-- Подразделение -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кабинет -->
                    <RowDefinition Height="Auto"/>
                    <!-- Держатель -->
                    <RowDefinition Height="Auto"/>
                    <!-- Передал -->
                    <RowDefinition Height="Auto"/>
                    <!-- Состояние -->
                    <RowDefinition Height="Auto"/>
                    <!-- Примечание -->
                </Grid.RowDefinitions>

                <!-- Дата -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата перемещения:" Margin="0,0,5,10"/>
                <DatePicker Grid.Row="0" Grid.Column="1"
                            x:Name="dpMovementDate"
                            Margin="0,0,0,10"/>

                <!-- Подразделение -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Подразделение:" Margin="0,0,5,10"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          x:Name="cbDepartment"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"
                          SelectionChanged="cbDepartment_SelectionChanged"
                          Margin="0,0,0,10"/>

                <!-- Кабинет -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Кабинет:" Margin="0,0,5,10"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          x:Name="cbRoom"
                          DisplayMemberPath="RoomNumber"
                          SelectedValuePath="RoomID"
                          Margin="0,0,0,10"/>

                <!-- Держатель -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Держатель:" Margin="0,0,5,10"/>
                <ComboBox Grid.Row="3" Grid.Column="1"
                          x:Name="cbHolder"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="EmployeeID"
                          Margin="0,0,0,10"/>

                <!-- Передал -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Передал:" Margin="0,0,5,10"/>
                <ComboBox Grid.Row="4" Grid.Column="1"
                          x:Name="cbTransferredBy"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="EmployeeID"
                          Margin="0,0,0,10"/>

                <!-- Состояние -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Состояние:" Margin="0,0,5,10"/>
                <ComboBox Grid.Row="5" Grid.Column="1"
                          x:Name="cbCondition"
                          DisplayMemberPath="ConditionName"
                          SelectedValuePath="ConditionID"
                          Margin="0,0,0,10"/>

                <!-- Примечание -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Примечание:" Margin="0,0,5,10"/>
                <TextBox Grid.Row="6" Grid.Column="1"
                         x:Name="txtNotes"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,10"/>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Сохранить"
                        Width="140"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>

                <Button Content="Отмена"
                        Width="120"
                        Click="BtnCancel_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
