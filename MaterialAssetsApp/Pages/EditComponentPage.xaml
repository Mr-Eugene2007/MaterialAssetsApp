<Page x:Class="MaterialAssetsApp.Pages.EditComponentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактировать компонент">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Редактирование комплектующего"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Название:"/>
            <TextBox x:Name="txtName" Margin="0,0,0,10"/>

            <TextBlock Text="Номер (серийный):"/>
            <TextBox x:Name="txtNumber" Margin="0,0,0,10"/>

            <TextBlock Text="Количество:"/>
            <TextBox x:Name="txtQuantity" Margin="0,0,0,10"/>

            <TextBlock Text="Примечание:"/>
            <TextBox x:Name="txtNotes" Height="80" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Сохранить"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

            <Button Content="Отмена"
                    Width="120"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
