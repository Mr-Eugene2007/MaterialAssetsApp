<Page x:Class="MaterialAssetsApp.Pages.AddEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список сотрудников -->
        <GroupBox Header="Список сотрудников" Margin="0,0,10,0">
            <DataGrid x:Name="dgEmployees"
                      AutoGenerateColumns="False"
                      SelectionChanged="dgEmployees_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding EmployeeID}" Width="50"/>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="120"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                    <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="120"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="СНИЛС" Binding="{Binding SNILS}" Width="120"/>
                </DataGrid.Columns>

            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Редактирование сотрудника"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия:"/>
                <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>

                <!-- Имя -->
                <TextBlock Text="Имя:"/>
                <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>

                <!-- Отчество -->
                <TextBlock Text="Отчество:"/>
                <TextBox x:Name="txtMiddleName" Margin="0,0,0,10"/>

                <!-- Дата рождения -->
                <TextBlock Text="Дата рождения:"/>
                <DatePicker x:Name="dpBirthDate" Margin="0,0,0,10"/>

                <!-- СНИЛС -->
                <TextBlock Text="СНИЛС:"/>
                <TextBox x:Name="txtSNILS" Margin="0,0,0,10"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон моб.:"/>
                <TextBox x:Name="txtPhoneMobile" Margin="0,0,0,10"/>

                <!-- Email -->
                <TextBlock Text="Email:"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>

                <!-- Дата приема -->
                <TextBlock Text="Дата приема:"/>
                <DatePicker x:Name="dpHireDate" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">


                    <Button Content="Сохранить"
                            Width="120"
                            Margin="0,0,10,0"
                            Click="BtnSave_Click"/>

                    <Button Content="Удалить"
                            Width="120"
                            Click="BtnDelete_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
