<Page x:Class="MaterialAssetsApp.Pages.AddEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="650"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Сотрудники"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Список сотрудников -->
        <GroupBox Grid.Row="1" Grid.Column="0"
                  Header="Список сотрудников"
                  Margin="0,0,10,0">
            <DataGrid x:Name="dgEmployees"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgEmployees_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding EmployeeID}" Width="50"/>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="120"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="100"/>
                    <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="120"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="СНИЛС" Binding="{Binding SNILS}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Редактирование сотрудника"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLastName" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtFirstName" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtMiddleName" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата рождения:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <DatePicker Grid.Row="3" Grid.Column="1" x:Name="dpBirthDate" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="СНИЛС:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtSNILS" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Телефон моб.:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtPhoneMobile" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtEmail" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата приема:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <DatePicker Grid.Row="7" Grid.Column="1" x:Name="dpHireDate" Margin="0,0,0,10"/>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,15,0,0">
                <Button Content="Сохранить"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button Content="Удалить"
                        Width="120"
                        Height="35"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>