<Page x:Class="MaterialAssetsApp.Pages.AddEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавить сотрудника">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Добавление сотрудника"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фамилия (обязательное) -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtLastName" Margin="0,0,0,5"/>

            <!-- Имя (обязательное) -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtFirstName" Margin="0,0,0,5"/>

            <!-- Отчество (необязательно) -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtMiddleName" Margin="0,0,0,5"/>

            <!-- Дата рождения (обязательное) -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата рождения:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="3" Grid.Column="1" x:Name="dpBirthDate" Margin="0,0,0,5"/>

            <!-- SNILS (обязательное, но без жесткой маски в UI) -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="СНИЛС:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtSNILS" Margin="0,0,0,5"/>

            <!-- Телефон мобильный (необязательно) -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Телефон моб.:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtPhoneMobile" Margin="0,0,0,5"/>

            <!-- Email (необязательно) -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtEmail" Margin="0,0,0,5"/>

            <!-- Дата приема (обязательное) -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата приема:" Margin="0,0,5,5" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="7" Grid.Column="1" x:Name="dpHireDate" Margin="0,0,0,5"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>
            <Button Content="Очистить"
                    Width="120"
                    Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Page>
