<Page x:Class="MaterialAssetsApp.Pages.EditAccountingCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование карточки">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Основные поля -->
                <RowDefinition Height="*"/>
                <!-- Комплектующие + кнопки -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Редактирование учетной карточки"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Основные поля -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Модель -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          x:Name="cbModel"
                          DisplayMemberPath="ModelName"
                          SelectedValuePath="ModelID"
                          Margin="0,0,0,5"/>

                <!-- Название -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Название ТС:" Margin="0,0,5,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAssetName" Margin="0,0,0,5"/>

                <!-- Инвентарный номер -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Инвентарный номер:" Margin="0,0,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtInventoryNumber" Margin="0,0,0,5"/>

                <!-- Серийный номер -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Серийный номер:" Margin="0,0,5,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtSerialNumber" Margin="0,0,0,5"/>

                <!-- Дата выпуска -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата выпуска:" Margin="0,0,5,5"/>
                <DatePicker Grid.Row="4" Grid.Column="1" x:Name="dpManufactureDate" Margin="0,0,0,5"/>

                <!-- Дата ввода -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата ввода в эксплуатацию:" Margin="0,0,5,5"/>
                <DatePicker Grid.Row="5" Grid.Column="1" x:Name="dpCommissionDate" Margin="0,0,0,5"/>

                <!-- Состояние -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Состояние:" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="6" Grid.Column="1"
                          x:Name="cbCondition"
                          DisplayMemberPath="ConditionName"
                          SelectedValuePath="ConditionID"
                          Margin="0,0,0,5"/>

                <!-- Подразделение -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Подразделение:" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="7" Grid.Column="1"
                          x:Name="cbDepartment"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"
                          Margin="0,0,0,5"
                          SelectionChanged="cbDepartment_SelectionChanged"/>

                <!-- Кабинет -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Кабинет:" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="8" Grid.Column="1"
                          x:Name="cbRoom"
                          DisplayMemberPath="RoomNumber"
                          SelectedValuePath="RoomID"
                          Margin="0,0,0,5"/>

                <!-- Ответственный -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Ответственный:" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="9" Grid.Column="1"
                          x:Name="cbResponsible"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="EmployeeID"
                          Margin="0,0,0,5"/>

                <!-- Держатель -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Текущий держатель:" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="10" Grid.Column="1"
                          x:Name="cbHolder"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="EmployeeID"
                          Margin="0,0,0,5"/>
            </Grid>

            <!-- Комплектующие -->
            <GroupBox Header="Комплектующие" Grid.Row="2" Margin="0,20,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgComponents"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Grid.Row="0"
                              Margin="0,0,0,10"
                              MouseDoubleClick="dgComponents_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding ComponentName}" Width="200"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding ComponentNumber}" Width="150"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Удалить" Width="120" Click="BtnDeleteComponent_Click"/>
                    </StackPanel>

                    <!-- Кнопки управления карточкой -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Просмотр перемещений"
                                Width="180"
                                Margin="0,0,10,0"
                                Click="BtnViewMovements_Click"/>

                        <Button Content="Печать"
                                Width="120"
                                Margin="0,0,10,0"
                                Click="BtnPrint_Click"/>

                        <Button Content="Сохранить изменения"
                                Width="150"
                                Margin="0,0,10,0"
                                Click="BtnSave_Click"/>

                        <Button Content="Отмена"
                                Width="120"
                                Click="BtnCancel_Click"/>
                    </StackPanel>

                </Grid>
            </GroupBox>

        </Grid>
    </ScrollViewer>
</Page>
