<Page x:Class="MaterialAssetsApp.Pages.EditAccountingCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование карточки">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Редактирование учетной карточки"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Левая колонка — основные поля -->
        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbModel"
                          DisplayMemberPath="ModelName" SelectedValuePath="ModelID" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Название ТС:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAssetName" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Инвентарный номер:" VerticalAlignment="Center" Margin="0,0,5,8" TextWrapping="Wrap"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtInventoryNumber" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Серийный номер:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtSerialNumber" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата выпуска:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <DatePicker Grid.Row="4" Grid.Column="1" x:Name="dpManufactureDate" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата ввода в эксплуатацию:" VerticalAlignment="Center" Margin="0,0,5,8" TextWrapping="Wrap"/>
                <DatePicker Grid.Row="5" Grid.Column="1" x:Name="dpCommissionDate" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Дата списания:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <DatePicker Grid.Row="6" Grid.Column="1" x:Name="dpDecommissionDate" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Состояние:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cbCondition"
                          DisplayMemberPath="ConditionName" SelectedValuePath="ConditionID" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Подразделение:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <ComboBox Grid.Row="8" Grid.Column="1" x:Name="cbDepartment"
                          DisplayMemberPath="DepartmentName" SelectedValuePath="DepartmentID"
                          SelectionChanged="cbDepartment_SelectionChanged" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Кабинет:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <ComboBox Grid.Row="9" Grid.Column="1" x:Name="cbRoom"
                          DisplayMemberPath="RoomNumber" SelectedValuePath="RoomID" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Ответственный:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <ComboBox Grid.Row="10" Grid.Column="1" x:Name="cbResponsible"
                          DisplayMemberPath="FullName" SelectedValuePath="EmployeeID" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Текущий держатель:" VerticalAlignment="Center" Margin="0,0,5,8"/>
                <ComboBox Grid.Row="11" Grid.Column="1" x:Name="cbHolder"
                          DisplayMemberPath="FullName" SelectedValuePath="EmployeeID" Margin="0,0,0,8"/>
            </Grid>
        </ScrollViewer>

        <!-- Правая колонка — комплектующие + кнопки -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Комплектующие">
                <DataGrid x:Name="dgComponents"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          MouseDoubleClick="dgComponents_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding ComponentName}" Width="*"/>
                        <DataGridTextColumn Header="Номер" Binding="{Binding ComponentNumber}" Width="130"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Кнопки комплектующих -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,8">
                <Button Content="Добавить компонент"
                        Width="160" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnAddComponent_Click"/>
                <Button Content="Удалить компонент"
                        Width="160" Height="32"
                        Click="BtnDeleteComponent_Click"/>
            </StackPanel>

            <!-- Кнопки управления карточкой -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Просмотр перемещений"
                        Width="180" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnViewMovements_Click"/>
                <Button Content="Печать"
                        Width="100" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnPrint_Click"/>
                <Button Content="Сохранить"
                        Width="120" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button Content="Отмена"
                        Width="100" Height="32"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>