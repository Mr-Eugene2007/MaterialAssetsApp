<Page x:Class="MaterialAssetsApp.Pages.SearchDepartmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поиск подразделения">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Поиск подразделения"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Название -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Название подразделения"/>
                <TextBox x:Name="txtDepartmentName"/>
            </StackPanel>

            <!-- Родительское подразделение -->
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Родительское подразделение"/>
                <ComboBox x:Name="cbParent"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"/>
            </StackPanel>

            <!-- Кнопка -->
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <Button Content="Поиск"
                        Width="120"
                        Height="30"
                        Click="BtnSearch_Click"/>
            </StackPanel>
        </Grid>

        <!-- Результаты -->
        <DataGrid Grid.Row="2"
                  x:Name="dgDepartments"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="dgDepartments_MouseDoubleClick"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding DepartmentID}" Width="60"/>
                <DataGridTextColumn Header="Название" Binding="{Binding DepartmentName}" Width="200"/>
                <DataGridTextColumn Header="Родитель" Binding="{Binding ParentName}" Width="200"/>
                <DataGridTextColumn Header="Количество кабинетов" Binding="{Binding RoomCount}" Width="150"/>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>
