<Page x:Class="MaterialAssetsApp.Pages.SearchDepartmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поиск подразделения"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Поиск подразделения"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Название подразделения" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDepartmentName" Width="220"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Родительское подразделение" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbParent"
                          Width="220"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Экспорт в Excel"
                        Width="140" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnExport_Click"/>
                <Button Content="Поиск"
                        Width="110" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnSearch_Click"/>
                <Button Content="Сбросить"
                        Width="110" Height="32"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </WrapPanel>

        <!-- Результаты -->
        <DataGrid Grid.Row="2"
                  x:Name="dgDepartments"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MouseDoubleClick="dgDepartments_MouseDoubleClick"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding DepartmentName}" Width="*"/>
                <DataGridTextColumn Header="Родитель" Binding="{Binding ParentName}" Width="250"/>
                <DataGridTextColumn Header="Кол-во кабинетов" Binding="{Binding RoomCount}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>