<Page x:Class="MaterialAssetsApp.Pages.SearchEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поиск сотрудника"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Поиск сотрудника"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="ФИО" Margin="0,0,0,3"/>
                <TextBox x:Name="txtName" Width="180"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Телефон" Margin="0,0,0,3"/>
                <TextBox x:Name="txtPhone" Width="160"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Подразделение" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbDepartment"
                          Width="180"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Должность" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbPosition"
                          Width="180"
                          DisplayMemberPath="PositionName"
                          SelectedValuePath="PositionID"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Экспорт в Excel"
                        Width="140" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnExport_Click"/>
                <Button Content="Поиск"
                        Width="100" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnSearch_Click"/>
                <Button Content="Сбросить"
                        Width="100" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnReset_Click"/>
                <Button Content="Удалить"
                        Width="100" Height="32"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </WrapPanel>

        <!-- Результаты -->
        <DataGrid Grid.Row="2"
                  x:Name="dgEmployees"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MouseDoubleClick="dgEmployees_MouseDoubleClick"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="220"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneMobile}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="200"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>