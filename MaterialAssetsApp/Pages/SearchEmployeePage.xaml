<Page x:Class="MaterialAssetsApp.Pages.SearchEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поиск сотрудника">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Поиск сотрудника"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ФИО -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="ФИО"/>
                <TextBox x:Name="txtName"/>
            </StackPanel>

            <!-- Телефон -->
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Телефон"/>
                <TextBox x:Name="txtPhone"/>
            </StackPanel>

            <!-- Подразделение -->
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="Подразделение"/>
                <ComboBox x:Name="cbDepartment"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"/>
            </StackPanel>

            <!-- Должность -->
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                <TextBlock Text="Должность"/>
                <ComboBox x:Name="cbPosition"
                          DisplayMemberPath="PositionName"
                          SelectedValuePath="PositionID"/>
            </StackPanel>

            <!-- Кнопка -->
            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button Content="Поиск"
            Width="120"
            Height="30"
            Margin="0,0,10,0"
            Click="BtnSearch_Click"/>
                <Button Content="Сбросить"
            Width="120"
            Height="30"
            Click="BtnReset_Click"/>
            </StackPanel>
        </Grid>

        <!-- Результаты -->
        <DataGrid Grid.Row="2"
                  x:Name="dgEmployees"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="dgEmployees_MouseDoubleClick"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EmployeeID}" Width="60"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneMobile}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="200"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="200"/>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>
