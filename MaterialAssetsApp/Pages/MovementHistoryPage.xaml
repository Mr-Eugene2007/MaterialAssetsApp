<Page x:Class="MaterialAssetsApp.Pages.MovementHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История перемещений"
      Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История перемещений"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="dgMovements"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="dgMovements_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding SequenceNumber}" Width="40"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding MovementDate}" Width="100"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="150"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomNumber}" Width="80"/>
                <DataGridTextColumn Header="Держатель" Binding="{Binding HolderName}" Width="150"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding ConditionName}" Width="120"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить"
                    Width="150"
                    Margin="0,0,10,0"
                    Click="BtnAdd_Click"/>

            
            <Button Content="Редактировать"
                    Width="150"
                    Margin="0,0,10,0"
                    Click="BtnEdit_Click"/>

            <Button Content="Назад"
                    Width="120"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
