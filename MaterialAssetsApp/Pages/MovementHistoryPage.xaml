<Page x:Class="MaterialAssetsApp.Pages.MovementHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История перемещений"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="История перемещений"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Таблица -->
        <DataGrid Grid.Row="1"
                  x:Name="dgMovements"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="dgMovements_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding SequenceNumber}" Width="40"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding MovementDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="180"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomNumber}" Width="90"/>
                <DataGridTextColumn Header="Держатель" Binding="{Binding HolderName}" Width="180"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding ConditionName}" Width="120"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Добавить"
                    Width="130" Height="32"
                    Margin="0,0,10,0"
                    Click="BtnAdd_Click"/>
            <Button Content="Редактировать"
                    Width="130" Height="32"
                    Margin="0,0,10,0"
                    Click="BtnEdit_Click"/>
            <Button Content="Назад"
                    Width="100" Height="32"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>