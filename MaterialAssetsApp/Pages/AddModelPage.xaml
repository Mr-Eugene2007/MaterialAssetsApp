<Page x:Class="MaterialAssetsApp.Pages.AddModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Модели"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="550"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Модели"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Список моделей -->
        <GroupBox Grid.Row="1" Grid.Column="0"
                  Header="Список моделей"
                  Margin="0,0,10,0">
            <DataGrid x:Name="dgModels"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgModels_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Тип" Binding="{Binding AssetType.TypeName}" Width="150"/>
                    <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="150"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Редактирование -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Редактирование модели"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" Text="Тип:" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="2"
                      x:Name="cbType"
                      DisplayMemberPath="TypeName"
                      SelectedValuePath="AssetTypeID"
                      Margin="0,0,0,15"/>

            <TextBlock Grid.Row="3" Text="Бренд:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="4" x:Name="txtBrand" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="5" Text="Модель:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="6" x:Name="txtModelName" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="Сохранить"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button Content="Удалить"
                        Width="120"
                        Height="35"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>