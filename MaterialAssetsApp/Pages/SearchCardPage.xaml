<Page x:Class="MaterialAssetsApp.Pages.SearchCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поиск учетной карточки">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Поиск учетной карточки"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Инвентарный номер" Margin="0,0,0,3"/>
                <TextBox x:Name="txtInvNumber" Width="160"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Название ТС" Margin="0,0,0,3"/>
                <TextBox x:Name="txtAssetName" Width="160"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Тип" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbType"
                          Width="160"
                          DisplayMemberPath="TypeName"
                          SelectedValuePath="AssetTypeID"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Модель" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbModel"
                          Width="160"
                          DisplayMemberPath="ModelName"
                          SelectedValuePath="ModelID"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,8">
                <TextBlock Text="Подразделение" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbDepartment"
                          Width="180"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Поиск"
                        Width="110" Height="32"
                        Margin="0,0,10,0"
                        Click="BtnSearch_Click"/>
                <Button Content="Сбросить"
                        Width="110" Height="32"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </WrapPanel>

        <!-- Результаты -->
        <DataGrid Grid.Row="2"
                  x:Name="dgCards"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="dgCards_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}" Width="110"/>
                <DataGridTextColumn Header="Название" Binding="{Binding AssetName}" Width="180"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding AssetType}" Width="130"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="130"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding CurrentDepartment}" Width="170"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding CurrentRoom}" Width="90"/>
                <DataGridTextColumn Header="Ответственный" Binding="{Binding ResponsiblePerson}" Width="170"/>
                <DataGridTextColumn Header="Держатель" Binding="{Binding CurrentHolder}" Width="170"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding CurrentCondition}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>