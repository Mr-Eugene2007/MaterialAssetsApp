<Page x:Class="MaterialAssetsApp.Pages.AddAssetTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Типы технических средств">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список типов -->
        <GroupBox Header="Список типов" Margin="0,0,10,0">
            <DataGrid x:Name="dgTypes"
                      AutoGenerateColumns="False"
                      SelectionChanged="dgTypes_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding TypeID}" Width="50"/>
                    <DataGridTextColumn Header="Название типа" Binding="{Binding TypeName}" Width="*" />
                </DataGrid.Columns>

            </DataGrid>
        </GroupBox>

        <!-- Редактирование -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">

            <TextBlock Text="Редактирование типа"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Название типа:"/>
            <TextBox x:Name="txtTypeName" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">


                <Button Content="Сохранить"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>

                <Button Content="Удалить"
                        Width="120"
                        Click="BtnDelete_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Page>
