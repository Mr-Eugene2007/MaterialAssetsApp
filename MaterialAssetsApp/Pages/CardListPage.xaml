<Page x:Class="MaterialAssetsApp.Pages.CardListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Карточки">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Массовое перемещение -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Назад -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="txtTitle"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Блок массового перемещения -->
        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,15"
            VerticalAlignment="Center"
            HorizontalAlignment="Left">

            <TextBlock Text="Увольняемый:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbOldEmployee"
              Width="200"
              DisplayMemberPath="FullName"
              SelectedValuePath="EmployeeID"
              Margin="0,0,20,0"/>

            <TextBlock Text="Новый держатель:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbNewEmployee"
              Width="200"
              DisplayMemberPath="FullName"
              SelectedValuePath="EmployeeID"
              Margin="0,0,20,0"/>

            <Button Content="Массовое перемещение"
            Width="180"/>
        </StackPanel>


        <!-- Таблица карточек -->
        <DataGrid x:Name="dgCards"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="dgCards_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}" Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding AssetName}" Width="200"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="150"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="150"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="150"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomNumber}" Width="100"/>
                <DataGridTextColumn Header="Держатель" Binding="{Binding HolderName}" Width="200"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding ConditionName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка назад -->
        <Button Grid.Row="3"
                Content="Назад"
                Width="120"
                HorizontalAlignment="Right"
                Click="BtnBack_Click"/>
    </Grid>
</Page>
