<Page x:Class="MaterialAssetsApp.Pages.CardListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Карточки">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Назад -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="txtTitle"
           FontSize="20"
           FontWeight="Bold"
           Margin="0,0,0,15"/>

        <!-- Кнопка перемещения -->
        <Button Grid.Row="1"
        Content="Переместить выбранные"
        Width="200"
        HorizontalAlignment="Left"
        Click="BtnMoveSelected_Click"/>

        <!-- Таблица карточек -->
        <DataGrid x:Name="dgCards"
          Grid.Row="2"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Extended"
          SelectionUnit="FullRow"
          MouseDoubleClick="dgCards_MouseDoubleClick">


            <DataGrid.Columns>


                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}" Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding AssetName}" Width="200"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="150"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="150"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="150"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomNumber}" Width="100"/>
                <DataGridTextColumn Header="Держатель" Binding="{Binding HolderName}" Width="200"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding ConditionName}" Width="120"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Назад -->
        <Button Grid.Row="3"
        Content="Назад"
        Width="120"
        HorizontalAlignment="Right"
        Click="BtnBack_Click"/>


    </Grid>
</Page>
