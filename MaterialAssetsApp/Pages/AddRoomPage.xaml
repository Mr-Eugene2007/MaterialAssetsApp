<Page x:Class="MaterialAssetsApp.Pages.AddRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинеты">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список кабинетов -->
        <GroupBox Header="Список кабинетов" Margin="0,0,10,0">
            <DataGrid x:Name="dgRooms"
                      AutoGenerateColumns="False"
                      SelectionChanged="dgRooms_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding RoomID}" Width="50"/>
                    <DataGridTextColumn Header="Подразделение" Binding="{Binding Department.DepartmentName}" Width="150"/>
                    <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>

            </DataGrid>
        </GroupBox>

        <!-- Редактирование -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">

            <TextBlock Text="Редактирование кабинета"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Подразделение -->
            <TextBlock Text="Подразделение:"/>
            <ComboBox x:Name="cbDepartment"
                      DisplayMemberPath="DepartmentName"
                      SelectedValuePath="DepartmentID"
                      Margin="0,0,0,10"/>

            <!-- Номер кабинета -->
            <TextBlock Text="Номер кабинета:"/>
            <TextBox x:Name="txtRoomNumber" Margin="0,0,0,10"/>

            <!-- Описание -->
            <TextBlock Text="Описание:"/>
            <TextBox x:Name="txtDescription"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">


                <Button Content="Сохранить"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>

                <Button Content="Удалить"
                        Width="120"
                        Click="BtnDelete_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Page>
