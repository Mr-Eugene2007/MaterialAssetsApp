<Page x:Class="MaterialAssetsApp.Pages.AddRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинеты">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="550"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Кабинеты"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Список кабинетов -->
        <GroupBox Grid.Row="1" Grid.Column="0"
                  Header="Список кабинетов"
                  Margin="0,0,10,0">
            <DataGrid x:Name="dgRooms"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgRooms_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Подразделение" Binding="{Binding Department.DepartmentName}" Width="200"/>
                    <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Редактирование -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Редактирование кабинета"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" Text="Подразделение:" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="2"
                      x:Name="cbDepartment"
                      DisplayMemberPath="DepartmentName"
                      SelectedValuePath="DepartmentID"
                      Margin="0,0,0,15"/>

            <TextBlock Grid.Row="3" Text="Номер кабинета:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="4" x:Name="txtRoomNumber" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="5" Text="Описание:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="6"
                     x:Name="txtDescription"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,20"/>

            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="Сохранить"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button Content="Удалить"
                        Width="120"
                        Height="35"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>