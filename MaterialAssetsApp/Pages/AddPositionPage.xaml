<Page x:Class="MaterialAssetsApp.Pages.AddPositionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Должности">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список должностей -->
        <GroupBox Header="Список должностей" Margin="0,0,10,0">
            <DataGrid x:Name="dgPositions"
                      AutoGenerateColumns="False"
                      SelectionChanged="dgPositions_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PositionID}" Width="50"/>
                    <DataGridTextColumn Header="Название должности" Binding="{Binding PositionName}" Width="*" />
                </DataGrid.Columns>

            </DataGrid>
        </GroupBox>

        <!-- Редактирование -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">

            <TextBlock Text="Редактирование должности"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Название должности:"/>
            <TextBox x:Name="txtPositionName" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">


                <Button Content="Сохранить"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"/>

                <Button Content="Удалить"
                        Width="120"
                        Click="BtnDelete_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Page>
