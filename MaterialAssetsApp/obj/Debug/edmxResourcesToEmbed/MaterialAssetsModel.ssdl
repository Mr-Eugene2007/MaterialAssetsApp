      <DefiningQuery>SELECT 
[vw_AssetCurrentLocation].[CardID] AS [CardID], 
[vw_AssetCurrentLocation].[InventoryNumber] AS [InventoryNumber], 
[vw_AssetCurrentLocation].[AssetName] AS [AssetName], 
[vw_AssetCurrentLocation].[ModelID] AS [ModelID], 
[vw_AssetCurrentLocation].[Brand] AS [Brand], 
[vw_AssetCurrentLocation].[ModelName] AS [ModelName], 
[vw_AssetCurrentLocation].[AssetTypeID] AS [AssetTypeID], 
[vw_AssetCurrentLocation].[AssetType] AS [AssetType], 
[vw_AssetCurrentLocation].[ConditionID] AS [ConditionID], 
[vw_AssetCurrentLocation].[CurrentCondition] AS [CurrentCondition], 
[vw_AssetCurrentLocation].[DepartmentID] AS [DepartmentID], 
[vw_AssetCurrentLocation].[CurrentDepartment] AS [CurrentDepartment], 
[vw_AssetCurrentLocation].[RoomID] AS [RoomID], 
[vw_AssetCurrentLocation].[CurrentRoom] AS [CurrentRoom], 
[vw_AssetCurrentLocation].[ResponsibleEmployeeID] AS [ResponsibleEmployeeID], 
[vw_AssetCurrentLocation].[ResponsiblePerson] AS [ResponsiblePerson], 
[vw_AssetCurrentLocation].[CurrentHolderID] AS [CurrentHolderID], 
[vw_AssetCurrentLocation].[CurrentHolder] AS [CurrentHolder], 
[vw_AssetCurrentLocation].[CommissionDate] AS [CommissionDate], 
[vw_AssetCurrentLocation].[DecommissionDate] AS [DecommissionDate], 
[vw_AssetCurrentLocation].[InitialCost] AS [InitialCost]
FROM [dbo].[vw_AssetCurrentLocation] AS [vw_AssetCurrentLocation]</DefiningQuery>
